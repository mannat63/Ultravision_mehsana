# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# Clerk Authentication (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Database (MongoDB Atlas connection string)
MONGODB_URI=

# Automation (n8n)
N8N_WEBHOOK_URL=

# WhatsApp API (Optional for direct calls, though handled via n8n)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# AI (Groq)
GROQ_API_KEY=

# Intellogy OS — analytics + health/error ingest
# INTELLOGY_OS_URL is the base URL (no trailing slash); the app POSTs to /api/health/ingest.
# INTELLOGY_HEALTH_TOKEN is the per-client token sent as the x-client-token header.
INTELLOGY_OS_URL=https://intellogy-os.vercel.app
INTELLOGY_HEALTH_TOKEN=
NEXT_PUBLIC_INTELLOGY_OS_URL=https://intellogy-os.vercel.app
NEXT_PUBLIC_INTELLOGY_HEALTH_TOKEN=

# Shared secret the external cron sends as `Authorization: Bearer <CRON_SECRET>`
# (only enforced in production). Used by /api/cron/health.
CRON_SECRET=
